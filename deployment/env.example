# Copy to ../.env only for a NEW installation. Never replace existing secrets.
# Generate each password/secret independently with: openssl rand -hex 32
# Replace image references deliberately; the deployed .env pins exact digests.
COMPOSE_PROJECT_NAME=new-api-prod
COMPOSE_FILE=docker-compose.production.yml
NEW_API_IMAGE=calciumion/new-api:v1.0.0-rc.47@sha256:938fa2713d4946723c9e9ce3076351c33f7770699fec92d23f3a26fd95791026
POSTGRES_IMAGE=postgres:15-alpine@sha256:54e0dd8e8cddcdbb9156c2486eed5a43eccb7214d7c6828097d41ce049fb3984
REDIS_IMAGE=redis:7-alpine@sha256:57e4255cc971b1c8d6f8a6ca283ac01bc3ecdd914273ef6bfaede87aaecd6541
NEW_API_PORT=3000
TAILSCALE_IP=
# Required when docker-compose.tailnet.yml is enabled. Add a DNS A record for
# NEW_API_HOSTNAME pointing to TAILSCALE_IP; users must be on the allowed tailnet.
# Web: http://NEW_API_HOSTNAME/ ; API base: http://NEW_API_HOSTNAME/v1
# Set the dashboard's ServerAddress to the web origin (without /v1).
CADDY_IMAGE=caddy:2-alpine@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f
NEW_API_HOSTNAME=newapi.example.com
# These addresses must not overlap host routes, other Docker networks, or VPNs.
NEW_API_PROXY_SUBNET=172.30.250.0/29
NEW_API_PROXY_IP=172.30.250.2
NEW_API_BACKEND_IP=172.30.250.3
# Codex egress uses the host's existing HTTP proxy without exposing it publicly.
# Bind to the actual gateway of the project ingress network, not 0.0.0.0.
# Only NEW_API_BACKEND_IP may connect. Other channels keep their own routing.
SOCAT_IMAGE=alpine/socat@sha256:603174b77eebaba25ba8f8ebb15e1234d6600409554e95d6fb203fd106150287
NEW_API_EGRESS_BIND=172.30.250.1
NEW_API_EGRESS_PORT=17890
NEW_API_HOST_PROXY_PORT=7890
# Codex channel proxy: http://172.30.250.1:17890 (adjust if these values change).
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
CRYPTO_SECRET=
# After local admin setup, append :docker-compose.tailnet.yml to COMPOSE_FILE.
# Daily backup/startup units assume this clone is at %h/new-api.
