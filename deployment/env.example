# Copy to ../.env only for a NEW installation. Never replace existing secrets.
# Generate each password/secret independently with: openssl rand -hex 32
# Replace image references deliberately; the deployed .env pins exact digests.
COMPOSE_PROJECT_NAME=new-api-prod
COMPOSE_FILE=docker-compose.production.yml
NEW_API_IMAGE=calciumion/new-api:v1.0.0-rc.47@sha256:938fa2713d4946723c9e9ce3076351c33f7770699fec92d23f3a26fd95791026
POSTGRES_IMAGE=postgres:15-alpine@sha256:54e0dd8e8cddcdbb9156c2486eed5a43eccb7214d7c6828097d41ce049fb3984
REDIS_IMAGE=redis:7-alpine@sha256:57e4255cc971b1c8d6f8a6ca283ac01bc3ecdd914273ef6bfaede87aaecd6541
NEW_API_PORT=3000
TAILSCALE_IP=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
CRYPTO_SECRET=
# After local admin setup, append :docker-compose.tailnet.yml to COMPOSE_FILE.
# Daily backup/startup units assume this clone is at %h/new-api.
